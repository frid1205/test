<?xml version="1.0" encoding="UTF-8"?>
<GlobalVariableEntities>
   <description>Default Execution Profile for REST API and Kafka Test</description>
   <name>default</name>
   <tag></tag>
   <defaultProfile>true</defaultProfile>
   <GlobalVariableEntity>
      <description>Base URL for RESTful API</description>
      <initValue>'https://jsonplaceholder.typicode.com'</initValue>
      <name>BASE_URL</name>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Apache Kafka Broker Bootstrap Servers</description>
      <initValue>'localhost:9092'</initValue>
      <name>KAFKA_BOOTSTRAP_SERVERS</name>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Target Kafka Topic for Consumer Testing</description>
      <initValue>'telecom.order.events'</initValue>
      <name>KAFKA_TOPIC</name>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Consumer Group ID</description>
      <initValue>'katalon-order-consumer-group'</initValue>
      <name>KAFKA_GROUP_ID</name>
   </GlobalVariableEntity>
   <GlobalVariableEntity>
      <description>Polling timeout in milliseconds</description>
      <initValue>5000</initValue>
      <name>KAFKA_POLL_TIMEOUT_MS</name>
   </GlobalVariableEntity>
</GlobalVariableEntities>
